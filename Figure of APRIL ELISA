## ---------------------------------------------------------------- 1. DATA ---
## Zero-substituted APRIL concentrations (ng/mL). 0 = below the limit of
## detection (this includes any value reported below the kit MDD).
## To use your own file instead, see the readxl block at the foot of this script.

april <- list(
  HC  = c(0, 0.8496, 0, 0, 0, 0, 0, 0, 0.86, 0, 0, 1.6013, 0, 0, 0, 0, 0,
          0, 0, 0, 1.3258, 0, 0, 0, 0, 0, 0, 0, 2.032, 4.2618, 0, 0, 3.1647, 0),
  GBS = c(2.4357, 0.9731, 0, 35.2239, 1.0103, 3.3313, 9.0881, 0, 1.0954, 0,
          1.7017, 2.7927, 1.313, 2.0206, 1.5278, 0, 1.18, 0, 0, 0, 1.5617,
          0, 0, 0, 0, 1.1925, 0),
  MS  = c(0, 0, 2.0074, 2.9823, 0, 2.4496, 0, 0, 0, 2.2256, 0, 4.6957, 3.2666,
          1.3144, 4.8849, 0, 0, 0, 0, 0, 0, 1.0776, 0, 12.7643, 2.0438),
  SLE = c(0, 4.86, 2.032, 2.7547, 3.4293, 1.7403, 0, 1.01, 0, 8.56, 3.65, 8.22,
          0, 0, 3.11, 0, 0, 1.3609, 0, 0, 2.76, 0, 6.6428, 4.3)
)

groups   <- c("HC", "GBS", "MS", "SLE")
cols     <- c(HC = "#8c8c8c", GBS = "#4c8fe3", MS = "#3fc191", SLE = "#f2a93b")
analyte  <- "APRIL"
unit     <- "ng/mL"
mdd      <- 0.4          # kit minimum detection dose, ng/mL
## Swapping in another analyte's vectors and its MDD reproduces the other panels:
## BAFF 2.68 pg/mL, IFN-alpha 1.07 pg/mL, IFN-beta 5.0 pg/mL, IFN-gamma 1.28 pg/mL.

## ------------------------------------------------------- 2. SYMLOG SCALE ---
## matplotlib SymmetricalLogTransform, base 10, linthresh = mdd, linscale = 0.6
linscale     <- 0.6
linscale_adj <- linscale / (1 - 1 / 10)

symlog <- function(x, linthresh = mdd) {
  s <- sign(x); a <- abs(x)
  ifelse(a <= linthresh,
         x * (linscale_adj / linthresh),
         s * (log10(a / linthresh) + linscale_adj))
}

## ------------------------------------------------------------ 3. STATS -----
## Kruskal-Wallis across the four groups
kw <- kruskal.test(april)

## Dunn's test, tie-corrected, Benjamini-Hochberg adjusted over all six pairs.
dunn_test <- function(x) {
  v  <- unlist(x, use.names = FALSE)
  g  <- rep(names(x), lengths(x))
  N  <- length(v)
  r  <- rank(v)
  mr <- tapply(r, g, mean)
  n  <- tapply(r, g, length)
  tie   <- table(v)
  sigma2 <- (N * (N + 1) / 12) - sum(tie^3 - tie) / (12 * (N - 1))
  pr <- combn(names(x), 2, simplify = FALSE)
  z  <- sapply(pr, function(p)
    (mr[[p[1]]] - mr[[p[2]]]) / sqrt(sigma2 * (1 / n[[p[1]]] + 1 / n[[p[2]]])))
  p  <- 2 * pnorm(-abs(z))
  data.frame(a = sapply(pr, `[`, 1), b = sapply(pr, `[`, 2),
             z = z, p = p, p_adj = p.adjust(p, "BH"), row.names = NULL)
}

dn <- dunn_test(april)
get_p <- function(g1, g2)
  dn$p_adj[(dn$a == g1 & dn$b == g2) | (dn$a == g2 & dn$b == g1)][1]

cat(sprintf("Kruskal-Wallis H = %.2f, df = %d, p = %.4f\n",
            kw$statistic, kw$parameter, kw$p.value))
print(dn, digits = 3)

## ----------------------------------------------------------- 4. GEOMETRY ---
top   <- max(unlist(april), na.rm = TRUE)
ylim  <- symlog(c(-mdd * 0.35, top * 9))
xlim  <- c(0.4, 4.6)
ticks <- c(0, 0.1, 1, 10, 100)
tick_labels <- expression(0, 10^-1, 10^0, 10^1, 10^2)

## whiskers as matplotlib draws them: furthest point inside 1.5 x IQR
box_stats <- function(v) {
  q <- quantile(v, c(.25, .5, .75), type = 7, na.rm = TRUE)
  iqr <- q[3] - q[1]
  lo <- min(v[v >= q[1] - 1.5 * iqr]); hi <- max(v[v <= q[3] + 1.5 * iqr])
  c(lo = lo, q1 = q[[1]], med = q[[2]], q3 = q[[3]], hi = hi)
}

## ------------------------------------------------------------- 5. PLOT -----
## Draws on whatever device is currently open. Called at the foot of the script
## with no device opened first, so it lands in the RStudio Plots pane.

draw_panel <- function() {

op <- par(mar = c(5.2, 5.2, 5.6, 1.2), mgp = c(3.4, 0.7, 0), las = 1,
          xaxs = "i", cex.axis = 1.0)
on.exit(par(op), add = TRUE)

plot(NA, xlim = xlim, ylim = ylim, axes = FALSE, xlab = "", ylab = "")

## reference lines
abline(h = symlog(mdd), lty = 2, col = "#d62728", lwd = 1.4)
abline(h = symlog(0),   lty = 3, col = "#555555", lwd = 1.2)

set.seed(11)   # jitter only; change freely, it carries no information
for (i in seq_along(groups)) {
  g <- groups[i]; v <- april[[g]]; k <- cols[[g]]
  bs <- box_stats(v)

  ## box: median and interquartile range
  rect(i - 0.275, symlog(bs[["q1"]]), i + 0.275, symlog(bs[["q3"]]),
       col = adjustcolor(k, alpha.f = 0.20), border = "#666666")
  segments(i - 0.275, symlog(bs[["med"]]), i + 0.275, symlog(bs[["med"]]),
           lwd = 2.2, col = "black")
  ## whiskers and caps
  segments(i, symlog(bs[["q3"]]), i, symlog(bs[["hi"]]), col = "#666666")
  segments(i, symlog(bs[["q1"]]), i, symlog(bs[["lo"]]), col = "#666666")
  segments(i - 0.14, symlog(bs[["hi"]]), i + 0.14, symlog(bs[["hi"]]), col = "#666666")
  segments(i - 0.14, symlog(bs[["lo"]]), i + 0.14, symlog(bs[["lo"]]), col = "#666666")

  ## every participant, filled if measured and open if set to 0
  xj  <- i + runif(length(v), -0.18, 0.18)
  det <- v > 0
  points(xj[det],  symlog(v[det]),  pch = 21, bg = k, col = "white", cex = 1.05)
  points(xj[!det], symlog(v[!det]), pch = 21, bg = NA, col = "#9a9a9a",
         cex = 1.05, lwd = 1.1)
}

## axes
axis(2, at = symlog(ticks), labels = tick_labels, lwd = 0, lwd.ticks = 1)
axis(1, at = seq_along(groups), labels = FALSE, lwd = 0, lwd.ticks = 1)
mtext(sprintf("%s\n%d (%d)", groups, lengths(april),
              sapply(april, function(v) sum(v > 0))),
      side = 1, at = seq_along(groups), line = 1.9, cex = 1.0)
mtext("group\nn (number of measured, non-zero values)", side = 1, line = 4.0, cex = 0.9)
mtext(sprintf("%s (%s, symlog scale)", analyte, unit), side = 2, line = 3.4,
      las = 0, cex = 1.05)
box(bty = "l")

## title: analyte and the omnibus test
mtext(analyte, side = 3, line = 3.1, cex = 1.1)
mtext(sprintf("Kruskal-Wallis H = %.2f, p = %s", kw$statistic,
              ifelse(kw$p.value < 0.001, "< 0.001", sprintf("%.3f", kw$p.value))),
      side = 3, line = 1.9, cex = 1.1)

## post-hoc brackets against healthy controls, at 1.3x / 2.6x / 5.2x the maximum
bracket <- function(x1, x2, y, p) {
  yt <- symlog(y); yb <- symlog(y * 0.93)
  lines(c(x1, x1, x2, x2), c(yb, yt, yt, yb), col = "#666666", lwd = 1.2)
  sig <- p < 0.05
  text(mean(c(x1, x2)), yt,
       ifelse(p < 0.001, "p < 0.001", sprintf("p = %.3f", p)),
       pos = 3, offset = 0.25, cex = 0.95,
       col = if (sig) "#8b0000" else "#666666", font = if (sig) 2 else 1)
}
for (k in 1:3) {
  g <- c("GBS", "MS", "SLE")[k]
  bracket(1, which(groups == g), top * c(1.3, 2.6, 5.2)[k], get_p(g, "HC"))
}

invisible(NULL)
}

