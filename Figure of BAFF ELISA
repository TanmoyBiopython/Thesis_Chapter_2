table(dat$group, dat$detected)      # 34/27/25/24, all TRUE

## ---- omnibus test, printed into the title -----------------------------------
kw    <- kruskal.test(baff ~ group, data = dat)
kw_lab <- sprintf("BAFF        Kruskal-Wallis H = %.2f, %s",
                  kw$statistic,
                  ifelse(kw$p.value < 0.001, "p < 0.001",
                         sprintf("p = %.3f", kw$p.value)))
kw_lab

## ---- box statistics ---------------------------------------------------------
box_stats <- dat |>
  group_by(group) |>
  summarise(
    n     = n(),
    det   = sum(detected),
    lower = quantile(baff, .25),
    mid   = median(baff),
    upper = quantile(baff, .75),
    ymin  = min(baff[baff >= quantile(baff, .25) - 1.5 * IQR(baff)]),
    ymax  = max(baff[baff <= quantile(baff, .75) + 1.5 * IQR(baff)]),
    .groups = "drop"
  )
box_stats

x_labels <- setNames(
  sprintf("%s\nn=%d\n%d det.", box_stats$group, box_stats$n, box_stats$det),
  box_stats$group
)

## ---- colours ----------------------------------------------------------------
fill_cols <- c(HC = "#c9c9c9", GBS = "#cfe0f5", MS = "#cceadb", SLE = "#fbe3b8")
pt_cols   <- c(HC = "#8a8a8a", GBS = "#3b7dd8", MS = "#21a179", SLE = "#e8a33d")

## ---- significance brackets (Dunn vs HC, BH-adjusted) ------------------------
## Edit lab/col/face here if your Dunn output differs.
brk <- tibble(
  x    = 1,
  xend = c(2, 3, 4),
  y    = c(9.0e3, 2.2e4, 5.0e4),          # data-scale heights
  lab  = c("p = 0.188", "p = 0.014", "p < 0.001"),
  col  = c("#8a8a8a", "#8b0000", "#8b0000"),
  face = c("plain", "bold", "bold")
)
tip <- 1.35                               # multiplicative drop of the bracket tips

## ---- figure -----------------------------------------------------------------
p <- ggplot() +
  ## shaded band below the detection limit
  annotate("rect", xmin = -Inf, xmax = Inf, ymin = 0.85, ymax = MDD,
           fill = "#f0f0f0") +

  ## boxes and whiskers from pre-computed statistics
  geom_boxplot(data = box_stats, stat = "identity", width = 0.55,
               aes(x = group, ymin = ymin, lower = lower, middle = mid,
                   upper = upper, ymax = ymax, fill = group),
               colour = "#8c8c8c", linewidth = 0.4, alpha = 0.75,
               show.legend = FALSE) +
  ## heavy median line
  geom_segment(data = box_stats, linewidth = 1.1, colour = "black",
               aes(x = as.numeric(group) - 0.275,
                   xend = as.numeric(group) + 0.275, y = mid, yend = mid)) +

  ## individual measurements
  geom_jitter(data = dat, aes(x = group, y = baff, colour = group),
              width = 0.15, height = 0, size = 1.9, alpha = 0.85,
              show.legend = FALSE) +

  ## detection-limit reference lines
  geom_hline(yintercept = MDD, linetype = "dashed",
             colour = "#d62728", linewidth = 0.5) +
  geom_hline(yintercept = IMPUTE, linetype = "dotted",
             colour = "#9a9a9a", linewidth = 0.45) +

  ## brackets: horizontal bar plus two descending tips
  geom_segment(data = brk, aes(x = x, xend = xend, y = y, yend = y),
               colour = brk$col, linewidth = 0.4) +
  geom_segment(data = brk, aes(x = x, xend = x, y = y, yend = y / tip),
               colour = brk$col, linewidth = 0.4) +
  geom_segment(data = brk, aes(x = xend, xend = xend, y = y, yend = y / tip),
               colour = brk$col, linewidth = 0.4) +
  geom_text(data = brk, aes(x = (x + xend) / 2, y = y * 1.55, label = lab),
            colour = brk$col, fontface = brk$face, size = 3.3) +

  scale_y_log10(limits = c(0.85, 1.3e5),
                breaks = c(1, 10, 100, 1000, 10000),
                labels = trans_format("log10", math_format(10^.x)),
                expand = c(0, 0)) +
  scale_x_discrete(labels = x_labels) +
  scale_fill_manual(values = fill_cols) +
  scale_colour_manual(values = pt_cols) +
  labs(x = NULL, y = "BAFF (pg/mL, log scale)", title = kw_lab) +
  theme_classic(base_size = 11) +
  theme(
    plot.title   = element_text(size = 11, hjust = 0.12,
                                margin = margin(b = 14), colour = "#222222"),
    axis.title.y = element_text(size = 10.5, colour = "#333333",
                                margin = margin(r = 6)),
    axis.text.x  = element_text(size = 9.5, colour = "#333333",
                                lineheight = 1.4, margin = margin(t = 5)),
    axis.text.y  = element_text(size = 10, colour = "#333333"),
    axis.line    = element_line(colour = "#444444", linewidth = 0.45),
    axis.ticks   = element_line(colour = "#444444"),
    plot.margin  = margin(12, 16, 8, 10)
  )

p        # <- appears in the RStudio Plots pane

## Opens a separate window at the intended size, if the Plots pane is cramped
print_fig <- function() {
  if (.Platform$OS.type == "windows") windows(width = 4.7, height = 5.0)
  else if (Sys.info()[["sysname"]] == "Darwin") quartz(width = 4.7, height = 5.0)
  else x11(width = 4.7, height = 5.0)
  print(p)
}
