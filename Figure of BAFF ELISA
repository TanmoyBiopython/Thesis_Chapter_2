## ------------------------------------------------------- 2. Y-AXIS SCALE ---
## matplotlib SymmetricalLogTransform, base 10, linthresh = mdd, linscale = 0.6
linscale     <- 0.6
linscale_adj <- linscale / (1 - 1 / 10)

tr <- function(x, linthresh = mdd) {
  if (!use_symlog) return(log10(x))
  s <- sign(x); a <- abs(x)
  ifelse(a <= linthresh,
         x * (linscale_adj / linthresh),
         s * (log10(a / linthresh) + linscale_adj))
}

## ------------------------------------------------------------ 3. STATS -----
kw <- kruskal.test(dat)

## Dunn's test, tie-corrected, Benjamini-Hochberg adjusted over all six pairs.
dunn_test <- function(x) {
  v  <- unlist(x, use.names = FALSE)
  g  <- rep(names(x), lengths(x))
  N  <- length(v)
  r  <- rank(v)
  mr <- tapply(r, g, mean)
  n  <- tapply(r, g, length)
  tie    <- table(v)
  sigma2 <- (N * (N + 1) / 12) - sum(tie^3 - tie) / (12 * (N - 1))
  pr <- combn(names(x), 2, simplify = FALSE)
  z  <- sapply(pr, function(p)
    (mr[[p[1]]] - mr[[p[2]]]) / sqrt(sigma2 * (1 / n[[p[1]]] + 1 / n[[p[2]]])))
  p  <- 2 * pnorm(-abs(z))
  data.frame(a = sapply(pr, `[`, 1), b = sapply(pr, `[`, 2),
             z = z, p = p, p_adj = p.adjust(p, "BH"), row.names = NULL)
}

dn <- dunn_test(dat)
get_p <- function(g1, g2)
  dn$p_adj[(dn$a == g1 & dn$b == g2) | (dn$a == g2 & dn$b == g1)][1]

fmt_p <- function(p, eq = TRUE)
  if (p < 0.001) "p < 0.001" else sprintf(if (eq) "p = %.3f" else "%.3f", p)

cat(sprintf("Kruskal-Wallis H = %.2f, df = %d, p = %.5f\n",
            kw$statistic, kw$parameter, kw$p.value))
print(dn, digits = 3)

## ----------------------------------------------------------- 4. GEOMETRY ---
top <- max(unlist(dat), na.rm = TRUE)
bot <- min(unlist(dat), na.rm = TRUE)
all_ticks <- c(0, 10^(0:4))
if (use_symlog) {
  ticks <- all_ticks
  tick_labels <- expression(0, 10^0, 10^1, 10^2, 10^3, 10^4)
  ylim <- tr(c(-mdd * 0.35, top * 9))
} else {
  ticks <- all_ticks[-1]
  tick_labels <- expression(10^0, 10^1, 10^2, 10^3, 10^4)
  ylim <- tr(c(bot / 2, top * 9))
}
xlim <- c(0.4, 4.6)

## whiskers as matplotlib draws them: furthest point inside 1.5 x IQR
box_stats <- function(v) {
  q <- quantile(v, c(.25, .5, .75), type = 7, na.rm = TRUE)
  iqr <- q[3] - q[1]
  lo <- min(v[v >= q[1] - 1.5 * iqr]); hi <- max(v[v <= q[3] + 1.5 * iqr])
  c(lo = lo, q1 = q[[1]], med = q[[2]], q3 = q[[3]], hi = hi)
}

## ------------------------------------------------------------- 5. PLOT -----
## Draws on whatever device is currently open. Called at the foot of the script
## with no device opened first, so it lands in the RStudio Plots pane.

draw_panel <- function() {

op <- par(mar = c(5.2, 5.2, 5.6, 1.2), mgp = c(3.4, 0.7, 0), las = 1,
          xaxs = "i", cex.axis = 1.0)
on.exit(par(op), add = TRUE)

plot(NA, xlim = xlim, ylim = ylim, axes = FALSE, xlab = "", ylab = "")

## reference lines: kit detection limit, and zero if it is on the axis
abline(h = tr(mdd), lty = 2, col = "#d62728", lwd = 1.4)
if (use_symlog) abline(h = tr(0), lty = 3, col = "#555555", lwd = 1.2)

set.seed(11)   # jitter only; change freely, it carries no information
for (i in seq_along(groups)) {
  g <- groups[i]; v <- dat[[g]]; k <- cols[[g]]
  bs <- box_stats(v)

  ## box: median and interquartile range
  rect(i - 0.275, tr(bs[["q1"]]), i + 0.275, tr(bs[["q3"]]),
       col = adjustcolor(k, alpha.f = 0.20), border = "#666666")
  segments(i - 0.275, tr(bs[["med"]]), i + 0.275, tr(bs[["med"]]),
           lwd = 2.2, col = "black")
  ## whiskers and caps
  segments(i, tr(bs[["q3"]]), i, tr(bs[["hi"]]), col = "#666666")
  segments(i, tr(bs[["q1"]]), i, tr(bs[["lo"]]), col = "#666666")
  segments(i - 0.14, tr(bs[["hi"]]), i + 0.14, tr(bs[["hi"]]), col = "#666666")
  segments(i - 0.14, tr(bs[["lo"]]), i + 0.14, tr(bs[["lo"]]), col = "#666666")

  ## every participant; filled if measured, open if below the detection limit
  xj  <- i + runif(length(v), -0.18, 0.18)
  det <- v > 0
  points(xj[det],  tr(v[det]),  pch = 21, bg = k, col = "white", cex = 1.05)
  if (any(!det))
    points(xj[!det], tr(v[!det]), pch = 21, bg = NA, col = "#9a9a9a",
           cex = 1.05, lwd = 1.1)
}

## axes
axis(2, at = tr(ticks), labels = tick_labels, lwd = 0, lwd.ticks = 1)
axis(1, at = seq_along(groups), labels = FALSE, lwd = 0, lwd.ticks = 1)
mtext(sprintf("%s\n%d (%d)", groups, lengths(dat),
              sapply(dat, function(v) sum(v > 0))),
      side = 1, at = seq_along(groups), line = 1.9, cex = 1.0)
mtext("group\nn (measured)", side = 1, line = 4.0, cex = 0.9)
mtext(sprintf("%s (%s, %s scale)", analyte, unit,
              if (use_symlog) "symlog" else "log"),
      side = 2, line = 3.4, las = 0, cex = 1.05)
box(bty = "l")

## title: analyte and the omnibus test
mtext(analyte, side = 3, line = 3.1, cex = 1.1)
mtext(sprintf("Kruskal-Wallis H = %.2f, %s", kw$statistic, fmt_p(kw$p.value)),
      side = 3, line = 1.9, cex = 1.1)

## post-hoc brackets against healthy controls, at 1.3x / 2.6x / 5.2x the maximum
bracket <- function(x1, x2, y, p) {
  yt <- tr(y); yb <- tr(y * 0.93)
  lines(c(x1, x1, x2, x2), c(yb, yt, yt, yb), col = "#666666", lwd = 1.2)
  sig <- p < 0.05
  text(mean(c(x1, x2)), yt, fmt_p(p), pos = 3, offset = 0.25, cex = 0.95,
       col = if (sig) "#8b0000" else "#666666", font = if (sig) 2 else 1)
}
for (k in 1:3) {
  g <- c("GBS", "MS", "SLE")[k]
  bracket(1, which(groups == g), top * c(1.3, 2.6, 5.2)[k], get_p(g, "HC"))
}

invisible(NULL)
}

