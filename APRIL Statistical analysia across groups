# 4. GROUP SUMMARIES
# -----------------------------------------------------------------------------
gm_boot <- function(x, nboot = 2000) {
  b <- replicate(nboot, mean(log10(sample(x, length(x), TRUE))))
  tibble(gm = 10^mean(log10(x)),
         gm_lo = 10^unname(quantile(b, .025)),
         gm_hi = 10^unname(quantile(b, .975)))
}

# 4a. All samples, non-detects at MDD/2. A median equal to 0.2 must be written
#     as "< 0.4 ng/mL", never as a measured concentration.
summ_all <- dat %>% group_split(group) %>%
  map_dfr(~bind_cols(
    tibble(group = .x$group[1], n = nrow(.x),
           median = median(.x$april),
           q1 = quantile(.x$april, .25), q3 = quantile(.x$april, .75),
           min = min(.x$april), max = max(.x$april)),
    gm_boot(.x$april))) %>%
  mutate(median_report = if_else(median <= IMPUTE,
                                 paste0("< ", MDD), sprintf("%.3f", median)))
summ_all

# Distribution-free CI for the median from binomial order statistics
median_ci_df <- function(x, conf = .95) {
  x <- sort(x); n <- length(x)
  k <- max(qbinom((1 - conf) / 2, n, .5), 1)
  tibble(lower = x[k], upper = x[n - k + 1],
         coverage = 1 - 2 * pbinom(k - 1, n, .5))
}
dat %>% group_split(group) %>%
  map_dfr(~bind_cols(tibble(group = .x$group[1]), median_ci_df(.x$april)))

# 4b. Detectable subset only — conditional summary. Do NOT test between groups.
