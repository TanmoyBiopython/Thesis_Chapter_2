# -----------------------------------------------------------------------------
# 2. DETECTION SUMMARY (Wilson intervals)
# -----------------------------------------------------------------------------
det_tab <- dat %>%
  group_by(group) %>%
  summarise(n = n(), detected = sum(detected), .groups = "drop") %>%
  mutate(non_det = n - detected, det_rate = 100 * detected / n) %>%
  rowwise() %>%
  mutate(ci = list(prop.test(detected, n, correct = FALSE)$conf.int),
         lo = 100 * ci[1], hi = 100 * ci[2]) %>%
  ungroup() %>% select(-ci)
det_tab

