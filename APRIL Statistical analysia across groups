# -----------------------------------------------------------------------------
# 5. POST-HOC — concentration (sensitivity analysis)
# -----------------------------------------------------------------------------
dunn <- dat %>% dunn_test(april ~ group, p.adjust.method = "BH")
dunn

pairwise_hl <- function(g1, g2) {
  d  <- dat %>% filter(group %in% c(g1, g2)) %>%
    mutate(group = factor(group, levels = c(g1, g2)))
  w  <- wilcox.test(april ~ group, data = d, conf.int = TRUE, exact = FALSE)
  rb <- wilcox_effsize(d, april ~ group, ci = TRUE, nboot = 2000)
  tibble(comparison = paste(g1, "vs", g2), U = unname(w$statistic),
         p = w$p.value, hl = unname(w$estimate),
         hl_lo = w$conf.int[1], hl_hi = w$conf.int[2],
         r = rb$effsize, r_lo = rb$conf.low, r_hi = rb$conf.high)
}
primary <- map_dfr(c("GBS", "MS", "SLE"), ~pairwise_hl(.x, "HC")) %>%
  mutate(p_bh = p.adjust(p, "BH"))
primary

exploratory <- bind_rows(pairwise_hl("GBS", "MS"),
                         pairwise_hl("GBS", "SLE"),
                         pairwise_hl("MS", "SLE")) %>%
  mutate(p_bh = p.adjust(p, "BH"))
exploratory

# Geometric mean ratio from the difference of log10 means (Welch)
gmr <- function(g1, g2) {
  t <- t.test(dat$log10_ap[dat$group == g1], dat$log10_ap[dat$group == g2])
  tibble(comparison = paste(g1, "vs", g2),
         GMR = 10^unname(t$estimate[1] - t$estimate[2]),
         lo = 10^t$conf.int[1], hi = 10^t$conf.int[2])
}
map_dfr(c("GBS", "MS", "SLE"), ~gmr(.x, "HC"))

# -----------------------------------------------------------------------------
# 6. POST-HOC — detection frequency (recommended primary contrast)
# -----------------------------------------------------------------------------
fisher_pair <- function(g1, g2, family) {
  m <- dat %>% filter(group %in% c(g1, g2)) %>%
    mutate(group = factor(group, levels = c(g1, g2))) %>%
    with(table(group, factor(detected, levels = c(TRUE, FALSE))))
  f <- fisher.test(m)
  tibble(comparison = paste(g1, "vs", g2), family = family,
         det1 = m[1, 1], n1 = sum(m[1, ]), det2 = m[2, 1], n2 = sum(m[2, ]),
         OR = unname(f$estimate), lo = f$conf.int[1], hi = f$conf.int[2],
         p = f$p.value)
}
det_primary <- map_dfr(c("GBS", "MS", "SLE"),
                       ~fisher_pair(.x, "HC", "primary")) %>%
  mutate(p_bh = p.adjust(p, "BH"))
det_expl <- bind_rows(fisher_pair("GBS", "MS", "exploratory"),
                      fisher_pair("GBS", "SLE", "exploratory"),
                      fisher_pair("MS", "SLE", "exploratory")) %>%
  mutate(p_bh = p.adjust(p, "BH"))
bind_rows(det_primary, det_expl)

